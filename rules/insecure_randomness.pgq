import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { mathRandom } from "../lib/sources.pgq";
import { storageSinks, requestHeaderSinks } from "../lib/sinks.pgq";

/** Math.random()-derived value stored or sent as a token */
export const sink: PGSelector = {
    from: mathRandom,
    mode: "deep",
    maxHops: 8,
    cypher: [
        ...storageSinks,
        ...requestHeaderSinks,
    ],
};

export default {
    id: "insecure_randomness",
    name: `Insecure randomness: Math.random() value stored as a cookie, in web storage or sent as a request header`,
    severity: "low",
    message: `Math.random()-derived value stored or sent as a token`,
    description: `Taint flow from Math.random() into document.cookie, localStorage/sessionStorage.setItem() or a request header (setRequestHeader, headers: {...}, new Headers, x.headers.X =). Math.random() is predictable, so a session id, CSRF token or nonce generated with it can be guessed. Use crypto.getRandomValues() or crypto.randomUUID().`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
