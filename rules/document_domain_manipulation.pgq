import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead } from "../lib/sources.pgq";

/** URL-derived value written to document.domain */
export const sink: PGSelector = {
    from: urlRead,
    mode: "deep",
    maxHops: 8,
    cypher: { query: `MATCH (asg:AssignmentExpression)-[:SON {key: 'left'}]->(l:MemberExpression)-[:SON {key: 'property'}]->(p:Identifier), (asg)-[:SON {key: 'right'}]->(n), (l)-[:SON {key: 'object'}]->(o:Identifier)
WHERE p.name IN ['domain'] AND o.name = 'document' AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral', 'RegExpLiteral']
RETURN n.id AS id, p.name + '=' AS kind, n.file AS file, n.line AS line, n.col AS col` },
};

export default {
    id: "document_domain_manipulation",
    name: `Document-domain manipulation: URL value written to document.domain`,
    severity: "medium",
    message: `URL-derived value written to document.domain`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) into document.domain. Lets an attacker relax the page's origin to a parent domain they share, so a page on a sibling subdomain can script this one.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
