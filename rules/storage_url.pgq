import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlReadNoHref } from "../lib/sources.pgq";
import { storageSinks } from "../lib/sinks.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** URL-derived value written to a cookie or web storage */
export const sink: PGSelector = {
    interceptors,
    from: urlReadNoHref,
    mode: "deep",
    maxHops: 8,
    cypher: storageSinks,
};

export default {
    id: "storage_url",
    name: `Storage manipulation: URL value written to a cookie or web storage`,
    severity: "low",
    message: `URL-derived value written to a cookie or web storage`,
    description: `Taint flow from location.hash/search or document.URL/documentURI/referrer/baseURI into document.cookie or localStorage/sessionStorage.setItem. location.href is not a source here: storing the current URL (return-to after login) is common and benign.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
