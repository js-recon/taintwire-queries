import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { pga } from "../lib/pga.pgq";
import { urlRead, windowName, responseBody, storedValue } from "../lib/sources.pgq";
import { messageData } from "../lib/postmessage.pgq";
import { interceptors } from "../lib/interceptors.pgq";

// Calls that put an element into the document: an element passed to one is not detached.
const insertions = pga.list(["appendChild", "insertBefore", "append", "prepend", "replaceWith", "replaceChild", "before", "after",
    "replaceChildren", "insertAdjacentElement", "appendTo", "prependTo", "insertAfter"]);

/** a detached element's innerHTML is used to strip tags or decode entities */
export const sink: PGSelector = {
    interceptors,
    from: [urlRead, windowName, messageData, responseBody, storedValue],
    mode: "deep",
    maxHops: 8,
    cypher: [
        // var d = document.createElement('div'); d.innerHTML = s; return d.textContent: the element isn't in the page,
        // but it belongs to the live document, so <img src=x onerror=...> in s still loads and runs. A <textarea> or
        // <template> (inert content) or an element of another document (DOMParser, createHTMLDocument) is safe.
        // The text must be read back (not only written, as Next's head-manager does in its other branch), and d must
        // never be inserted (next/script appends it: then it is an ordinary innerHTML sink, reported by other rules).
        // shortcut: a var/let/const-declared element only, not one assigned later (d = document.createElement(...)).
        { query: `MATCH ${pga.methodCall()}, (c)${pga.arguments("a")}(t), (cm)${pga.object}(o)
WHERE p.name = 'createElement' AND a.idx = 0 AND ${pga.named("o", "document")}
  AND NOT (t.type = 'StringLiteral' AND lower(t.value) IN ['textarea', 'template'])
MATCH (c)<-[:SON {key: 'init'}]-(:VariableDeclarator)-[:SON {key: 'id'}]->(d:Identifier)
MATCH (d)${pga.referencedBy}(o1:Identifier)${pga.of.object}(m1:MemberExpression)${pga.property}(p1:Identifier), (m1)${pga.of.left}(asg:AssignmentExpression)${pga.right}(n)
WHERE p1.name = 'innerHTML' AND NOT n.type IN ${pga.literals}
MATCH (d)${pga.referencedBy}(o2:Identifier)${pga.of.object}(m2:MemberExpression)${pga.property}(p2:Identifier)
WHERE p2.name IN ['textContent', 'innerText']
  AND NOT EXISTS { MATCH (zw)-[:SON {key: 'left'}]->(m2) WHERE zw.type = 'AssignmentExpression' }
  AND NOT EXISTS { MATCH (d)${pga.referencedBy}(zr:Identifier)<-[:SON {key: 'arguments'}]-(zc:CallExpression)-[:SON {key: 'callee'}]->(:MemberExpression)-[:SON {key: 'property'}]->(zp:Identifier)
    WHERE zp.name IN ${insertions} }
RETURN DISTINCT n.id AS id, d.name + '.innerHTML then .' + p2.name AS kind, ${pga.loc()}` },
    ],
};

export default {
    id: "innerhtml_detached_decode",
    name: `DOM XSS: innerHTML of a detached element used to strip tags or decode entities`,
    severity: "medium",
    message: `an untrusted value is written to a detached element's innerHTML to read its text back; any event handler in it runs`,
    description: `A helper creates an element with document.createElement, assigns a value from the URL, window.name, a postMessage, an HTTP response or storage to its innerHTML and reads textContent/innerText back, to strip tags or decode HTML entities. The element is never inserted, but it belongs to the live document, so <img src=x onerror=...> in the value loads and runs its handler (HackerOne #406587, #753971, #308155). Use DOMParser or document.implementation.createHTMLDocument(), a <template>, or a <textarea> for decoding.`,
    author: "shriyanss",
    tags: ["dom-xss", "sanitizer"],
    return: [sink],
} satisfies PGRule;
