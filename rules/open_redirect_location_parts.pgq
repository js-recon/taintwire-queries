import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlReadNoHref } from "../lib/sources.pgq";
import { pga } from "../lib/pga.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** URL-derived value navigates the page */
export const sink: PGSelector = {
    interceptors,
    from: urlReadNoHref,
    mode: "deep",
    maxHops: 8,
    cypher: [
        { query: `MATCH (asg:AssignmentExpression)${pga.left}(l:MemberExpression)${pga.property}(p:Identifier), (asg)${pga.right}(n), (l)${pga.object}(o)
WHERE p.name IN ['host', 'hostname', 'protocol'] AND ${pga.named("o", "location")} AND NOT n.type IN ${pga.literals}
${pga.ret("p.name + '='")}` },
        { query: `MATCH ${pga.methodCall()}, (c)${pga.arguments("a")}(n), (cm)${pga.object}(o:Identifier)
WHERE p.name IN ['navigate'] AND a.idx = 0 AND o.name = 'navigation' AND NOT n.type IN ${pga.literals}
${pga.ret("p.name")}` },
    ],
};

export default {
    id: "open_redirect_location_parts",
    name: `Open redirect: URL value written to location.host/hostname/protocol or navigation.navigate()`,
    severity: "medium",
    message: `URL-derived value navigates the page`,
    description: `Taint flow from location.hash/search or document.URL/documentURI/referrer/baseURI (location.href is not a source here: frameworks and libraries routinely use the current URL) into location.host, location.hostname or location.protocol assignments, or the Navigation API navigation.navigate(). Complements detect_taintwire_open_redirect_url, which covers location/href assignment, location.assign/replace, window.open and URL attributes.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
