import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlReadNoHref } from "../lib/sources.pgq";

/** URL-derived value navigates the page */
export const sink: PGSelector = {
    from: urlReadNoHref,
    mode: "deep",
    maxHops: 8,
    cypher: [
        { query: `MATCH (asg:AssignmentExpression)-[:SON {key: 'left'}]->(l:MemberExpression)-[:SON {key: 'property'}]->(p:Identifier), (asg)-[:SON {key: 'right'}]->(n), (l)-[:SON {key: 'object'}]->(o)
WHERE p.name IN ['host', 'hostname', 'protocol'] AND (o.name = 'location' OR EXISTS { MATCH (o)-[:SON {key: 'property'}]->(q:Identifier) WHERE q.name = 'location' }) AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral', 'RegExpLiteral']
RETURN n.id AS id, p.name + '=' AS kind, n.file AS file, n.line AS line, n.col AS col` },
        { query: `MATCH (c:CallExpression)-[:SON {key: 'callee'}]->(cm:MemberExpression)-[:SON {key: 'property'}]->(p:Identifier), (c)-[a:SON {key: 'arguments'}]->(n), (cm)-[:SON {key: 'object'}]->(o:Identifier)
WHERE p.name IN ['navigate'] AND a.idx = 0 AND o.name = 'navigation' AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral', 'RegExpLiteral']
RETURN n.id AS id, p.name AS kind, n.file AS file, n.line AS line, n.col AS col` },
    ],
};

export default {
    id: "open_redirect_location_parts",
    name: `Open redirect: URL value written to location.host/hostname/protocol or navigation.navigate()`,
    severity: "medium",
    message: `URL-derived value navigates the page`,
    description: `Taint flow from location.hash/search or document.URL/documentURI/referrer/baseURI (location.href is not a source here: frameworks and libraries routinely use the current URL) into location.host, location.hostname or location.protocol assignments, or the Navigation API navigation.navigate(). Complements detect_taintwire_open_redirect_url, which covers location/href assignment, location.assign/replace, window.open and URL attributes.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
