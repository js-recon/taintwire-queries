import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { storedValue } from "../lib/sources.pgq";
import { htmlSinks, frameworkHtmlSinks, jsExecSinks, scriptSinks } from "../lib/sinks.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** stored value reaches an HTML or JavaScript execution sink */
export const sink: PGSelector = {
    interceptors,
    from: storedValue,
    mode: "deep",
    maxHops: 8,
    cypher: [
        ...htmlSinks,
        ...frameworkHtmlSinks,
        ...jsExecSinks,
        ...scriptSinks,
    ],
};

export default {
    id: "stored_dom_xss",
    name: `Stored DOM XSS: web storage, cookie or history.state value reaches an HTML or JavaScript execution sink`,
    severity: "medium",
    message: `stored value reaches an HTML or JavaScript execution sink`,
    description: `Taint flow from localStorage/sessionStorage.getItem(), a document.cookie read or history.state into an HTML sink (innerHTML/outerHTML/srcdoc, document.write, insertAdjacentHTML, jQuery .html(), dangerouslySetInnerHTML, v-html, jQuery $(), DOMParser, Angular bypassSecurityTrust*) or a JavaScript execution sink (eval, Function, string timers, script loading). Anything that can write the stored value (another page on the origin, a URL parameter stored earlier, a subdomain cookie) gets persistent script execution.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
