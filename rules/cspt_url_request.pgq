import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlReadNoHref, windowName } from "../lib/sources.pgq";
import { requestUrlSinks } from "../lib/sinks.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** URL-derived value reaches a request URL */
export const sink: PGSelector = {
    interceptors,
    from: [urlReadNoHref, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: requestUrlSinks,
};

export default {
    id: "cspt_url_request",
    name: `Client-side path traversal: URL value reaches a request URL`,
    severity: "medium",
    message: `URL-derived value reaches a request URL`,
    description: `Taint flow from location.hash/search, document.URL/documentURI/referrer/baseURI or window.name (location.href is not a source here: polyfills and libraries routinely request the current URL) into the URL of a request: fetch, $fetch, axios and axios.get/post/..., window.fetch, XMLHttpRequest.open, new WebSocket or new EventSource. Review whether the value can change the request path.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
