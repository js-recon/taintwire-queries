import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";

/** URL-derived value reaches a JavaScript execution sink */
export const sink: PGSelector = {
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: [
        { query: `MATCH (c:CallExpression)-[:SON {key: 'callee'}]->(f:Identifier), (c)-[a:SON {key: 'arguments'}]->(n)
WHERE ((f.name IN ['eval', 'setTimeout', 'setInterval'] AND a.idx = 0) OR f.name = 'Function') AND NOT n.type IN ['FunctionExpression', 'ArrowFunctionExpression', 'FunctionDeclaration'] AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral']
RETURN n.id AS id, f.name AS kind, n.file AS file, n.line AS line, n.col AS col` },
        { query: `MATCH (c:NewExpression)-[:SON {key: 'callee'}]->(f:Identifier), (c)-[a:SON {key: 'arguments'}]->(n)
WHERE ((f.name IN ['eval', 'setTimeout', 'setInterval'] AND a.idx = 0) OR f.name = 'Function') AND NOT n.type IN ['FunctionExpression', 'ArrowFunctionExpression', 'FunctionDeclaration'] AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral']
RETURN n.id AS id, f.name AS kind, n.file AS file, n.line AS line, n.col AS col` },
        { query: `MATCH (c:CallExpression)-[:SON {key: 'callee'}]->(cm:MemberExpression)-[:SON {key: 'property'}]->(p:Identifier), (c)-[a:SON {key: 'arguments'}]->(n)
WHERE p.name IN ['eval', 'setTimeout', 'setInterval'] AND a.idx = 0 AND NOT n.type IN ['FunctionExpression', 'ArrowFunctionExpression', 'FunctionDeclaration'] AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral']
RETURN n.id AS id, p.name AS kind, n.file AS file, n.line AS line, n.col AS col` },
    ],
};

export default {
    id: "js_exec_url",
    name: `JS execution: URL or window.name value reaches eval/Function/string timer`,
    severity: "high",
    message: `URL-derived value reaches a JavaScript execution sink`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into eval(), Function()/new Function(), or a string argument to setTimeout/setInterval. Flow is followed through variables, resolved calls and wrapping calls (deep mode).`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
