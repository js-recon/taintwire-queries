import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";
import { jsExecSinks } from "../lib/sinks.pgq";

/** URL-derived value reaches a JavaScript execution sink */
export const sink: PGSelector = {
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: jsExecSinks,
};

export default {
    id: "js_exec_url",
    name: `JS execution: URL or window.name value reaches eval/Function/string timer`,
    severity: "high",
    message: `URL-derived value reaches a JavaScript execution sink`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into eval(), Function()/new Function(), or a string argument to setTimeout/setInterval. Flow is followed through variables, resolved calls and wrapping calls (deep mode).`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
