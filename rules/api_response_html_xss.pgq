import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { responseBody } from "../lib/sources.pgq";
import { htmlSinks, frameworkHtmlSinks, jsExecSinks } from "../lib/sinks.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** response data reaches an HTML or JavaScript execution sink */
export const sink: PGSelector = {
    interceptors,
    from: responseBody,
    mode: "deep",
    maxHops: 8,
    cypher: [
        ...htmlSinks,
        ...frameworkHtmlSinks,
        ...jsExecSinks,
    ],
};

export default {
    id: "api_response_html_xss",
    name: `Stored XSS: HTTP response data reaches an HTML or JavaScript execution sink`,
    severity: "medium",
    message: `response data reaches an HTML or JavaScript execution sink`,
    description: `Taint flow from an HTTP response body (await response.json() / response.text(), XMLHttpRequest.responseText/responseXML) into an HTML sink (innerHTML/outerHTML/srcdoc, document.write, insertAdjacentHTML, jQuery .html()/$(), dangerouslySetInnerHTML, v-html, DOMParser, Angular bypassSecurityTrust*) or a JavaScript execution sink. If the API returns user-supplied content (comments, profiles, messages), this is stored XSS. Values passed through promise .then() callbacks or framework state are not followed; await is.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
