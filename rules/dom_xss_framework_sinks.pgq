import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";
import { frameworkHtmlSinks } from "../lib/sinks.pgq";

/** URL-derived value reaches an HTML-parsing or trust sink */
export const sink: PGSelector = {
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: frameworkHtmlSinks,
};

export default {
    id: "dom_xss_framework_sinks",
    name: `DOM XSS: URL or window.name value reaches a jQuery, Angular trust or HTML parser sink`,
    severity: "high",
    message: `URL-derived value reaches an HTML-parsing or trust sink`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into a sink that parses or trusts HTML: a jQuery $()/jQuery() selector call, .wrap()/.wrapAll()/.wrapInner(), $.parseHTML, DOMParser.parseFromString, Document.parseHTMLUnsafe, document.execCommand('insertHTML', ...), or an Angular DomSanitizer bypassSecurityTrust* call. Complements detect_taintwire_dom_xss_url, which covers the DOM property and method sinks.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
