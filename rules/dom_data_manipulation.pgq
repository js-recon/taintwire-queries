import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlReadNoHref } from "../lib/sources.pgq";
import { pga } from "../lib/pga.pgq";

/** URL-derived value written to DOM data */
export const sink: PGSelector = {
    from: urlReadNoHref,
    mode: "deep",
    maxHops: 8,
    cypher: [
        { query: `MATCH ${pga.methodCall()}, (c)${pga.arguments("a")}(n)
WHERE p.name IN ['pushState', 'replaceState'] AND a.idx = 2 AND NOT n.type IN ${pga.literals}
${pga.ret("p.name")}` },
        { query: `MATCH (asg:AssignmentExpression)${pga.left}(l:MemberExpression)${pga.property}(p:Identifier), (asg)${pga.right}(n)
WHERE p.name IN ['target', 'method', 'enctype', 'encoding'] AND NOT n.type IN ${pga.literals}
${pga.ret("p.name + '='")}` },
    ],
};

export default {
    id: "dom_data_manipulation",
    name: `DOM-data manipulation: URL value written to history state URL or a form/link control attribute`,
    severity: "info",
    message: `URL-derived value written to DOM data`,
    description: `Taint flow from location.hash/search or document.URL/documentURI/referrer/baseURI (location.href is not a source here: frameworks and libraries routinely use the current URL) into history.pushState()/replaceState() URL arguments or the target/method/enctype/encoding of an element. These change the address bar or where and how a form submits; they are inputs for other attacks (spoofed URLs, form hijacking) rather than direct script execution. Text-only sinks (textContent, innerText, value) are safe and are not reported.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
