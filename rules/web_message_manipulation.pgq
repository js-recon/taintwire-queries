import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";
import { pga } from "../lib/pga.pgq";

/** URL-derived value sent with postMessage */
export const sink: PGSelector = {
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: [
        { query: `MATCH ${pga.methodCall()}, (c)${pga.arguments("a")}(n)
WHERE p.name IN ['postMessage'] AND a.idx IN [0, 1] AND NOT n.type IN ${pga.literals}
${pga.ret("p.name")}` },
        { query: `MATCH ${pga.methodCall()}, (c)${pga.arguments("a")}(:ObjectExpression)${pga.properties}(op:ObjectProperty)${pga.value}(n)
WHERE p.name = 'postMessage' AND a.idx = 0 AND NOT n.type IN ${pga.literals}
${pga.ret("'postMessage({...})'")}` },
    ],
};

export default {
    id: "web_message_manipulation",
    name: `Web message manipulation: URL or window.name value sent with postMessage or used as its target origin`,
    severity: "medium",
    message: `URL-derived value sent with postMessage`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into the data or targetOrigin argument of x.postMessage(). Attacker data relayed to another window reaches that window's message handler as if this page sent it; an attacker-chosen targetOrigin sends the message to the attacker.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
