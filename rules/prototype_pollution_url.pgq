import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";
import { prototypePollutionSinks } from "../lib/sinks.pgq";

/** URL-derived value reaches a prototype-polluting operation */
export const sink: PGSelector = {
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: prototypePollutionSinks,
};

export default {
    id: "prototype_pollution_url",
    name: `Prototype pollution: URL or window.name value reaches a nested computed assignment or deep merge`,
    severity: "medium",
    message: `URL-derived value reaches a prototype-polluting operation`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into the key of a nested computed assignment (obj[key][k] = v, where key = '__proto__' writes Object.prototype) or into the source of a deep merge: lodash merge/mergeWith/defaultsDeep/setWith/zipObjectDeep, deepmerge/deepExtend, or jQuery $.extend(true, ...). Polluted prototypes become gadgets for XSS or logic bypasses.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
