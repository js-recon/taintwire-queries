import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";

/** URL-derived value reaches a SQL statement */
export const sink: PGSelector = {
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: [
        { query: `MATCH (c:CallExpression)-[:SON {key: 'callee'}]->(cm:MemberExpression)-[:SON {key: 'property'}]->(p:Identifier), (c)-[a:SON {key: 'arguments'}]->(n)
WHERE p.name IN ['executeSql', 'prepare', 'selectValue', 'selectObjects'] AND a.idx = 0 AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral', 'RegExpLiteral']
RETURN n.id AS id, p.name AS kind, n.file AS file, n.line AS line, n.col AS col` },
        { query: `MATCH (op:ObjectProperty)-[:SON {key: 'key'}]->(k:Identifier), (op)-[:SON {key: 'value'}]->(n)
WHERE k.name = 'sql' AND NOT n.type IN ['StringLiteral', 'NumericLiteral', 'NullLiteral', 'BooleanLiteral', 'RegExpLiteral']
RETURN n.id AS id, 'sql:' AS kind, n.file AS file, n.line AS line, n.col AS col` },
    ],
};

export default {
    id: "client_side_sql_injection",
    name: `Client-side SQL injection: URL or window.name value reaches a browser database query`,
    severity: "high",
    message: `URL-derived value reaches a SQL statement`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into the SQL text of a client-side database: WebSQL tx.executeSql(), SQLite WASM / sql.js db.prepare()/selectValue()/selectObjects(), or a { sql: ... } exec option object.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
