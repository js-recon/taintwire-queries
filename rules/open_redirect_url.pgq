import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlReadNoHref } from "../lib/sources.pgq";
import { navigationSinks } from "../lib/sinks.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** URL-derived value reaches a navigation sink */
export const sink: PGSelector = {
    interceptors,
    from: urlReadNoHref,
    mode: "deep",
    maxHops: 8,
    cypher: navigationSinks,
};

export default {
    id: "open_redirect_url",
    name: `Open redirect: URL value reaches a navigation sink`,
    severity: "medium",
    message: `URL-derived value reaches a navigation sink`,
    description: `Taint flow from location.hash/search or document.URL/documentURI/referrer/baseURI into a navigation sink: location assignment, x.location/x.href assignment, location.assign/replace, window.open, or setAttribute of href/src/action/formaction/srcdoc. location.href is not a source here: frameworks and libraries routinely navigate with the current URL.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
