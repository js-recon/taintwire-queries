import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";
import { pga } from "../lib/pga.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** URL-derived value reaches an XPath expression */
export const sink: PGSelector = {
    interceptors,
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: { query: `MATCH ${pga.methodCall()}, (c)${pga.arguments("a")}(n)
WHERE p.name IN ['evaluate', 'createExpression', 'selectNodes', 'selectSingleNode'] AND a.idx = 0 AND NOT n.type IN ${pga.literals}
${pga.ret("p.name")}` },
};

export default {
    id: "xpath_injection",
    name: `Client-side XPath injection: URL or window.name value reaches an XPath expression`,
    severity: "medium",
    message: `URL-derived value reaches an XPath expression`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into the expression of document.evaluate()/XPathEvaluator.evaluate(), createExpression(), or selectNodes()/selectSingleNode().`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
