import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlReadNoHref } from "../lib/sources.pgq";
import { requestExtendedSinks } from "../lib/sinks.pgq";

/** URL-derived value reaches a request URL */
export const sink: PGSelector = {
    from: urlReadNoHref,
    mode: "deep",
    maxHops: 8,
    cypher: requestExtendedSinks,
};

export default {
    id: "cspt_extended_request",
    name: `Client-side path traversal / request forgery: URL value reaches a request URL (jQuery, Beacon, Request, config objects)`,
    severity: "medium",
    message: `URL-derived value reaches a request URL`,
    description: `Taint flow from location.hash/search or document.URL/documentURI/referrer/baseURI (location.href is not a source here: frameworks and libraries routinely use the current URL) into a request URL not covered by detect_taintwire_cspt_url_request: jQuery $.ajax/$.get/$.post/$.getJSON/.load(), navigator.sendBeacon(), new Request(), or the url/baseURL property of a request config object that also sets a request option such as method, headers, data or params (axios({url, method}), $.ajax({url, dataType}), axios.create({baseURL, headers})). Check whether the value can change the request path or host.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
