import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";
import { pga } from "../lib/pga.pgq";

/** URL-derived value selects a method to call */
export const sink: PGSelector = {
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: { query: `MATCH (c:CallExpression)${pga.callee}(m:MemberExpression)${pga.property}(n)
WHERE m.props CONTAINS '"computed":true' AND NOT n.type IN ${pga.literals}
${pga.ret("'obj[key]()'")}` },
};

export default {
    id: "unsafe_dynamic_method_call",
    name: `Unsafe dynamic method call: URL or window.name value selects the method to call`,
    severity: "medium",
    message: `URL-derived value selects a method to call`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into the computed property of a call (obj[name](...)). An attacker chooses which method runs, for example constructor, a privileged handler, or a gadget such as Function via obj.constructor.constructor.`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
