import type { PGRule, PGSelector } from "@js-recon/taintwire";
import { urlRead, windowName } from "../lib/sources.pgq";
import { scriptSinks } from "../lib/sinks.pgq";
import { interceptors } from "../lib/interceptors.pgq";

/** URL-derived value reaches a script loading or execution sink */
export const sink: PGSelector = {
    interceptors,
    from: [urlRead, windowName],
    mode: "deep",
    maxHops: 8,
    cypher: scriptSinks,
};

export default {
    id: "script_injection_url",
    name: `Script injection: URL or window.name value reaches a script URL or script text sink`,
    severity: "high",
    message: `URL-derived value reaches a script loading or execution sink`,
    description: `Taint flow from a URL read (location.hash/search/href, document.URL/documentURI/referrer/baseURI) or window.name into a sink that loads or runs script: new Worker()/SharedWorker(), importScripts(), navigator.serviceWorker.register(), dynamic import(), jQuery $.getScript()/$.globalEval(), setImmediate()/execScript() with a string, an inline event-handler attribute (setAttribute('on...', v)), or the src/text/textContent of a <script> element created with document.createElement('script').`,
    author: "shriyanss",
    tags: ["next", "vue", "react", "svelte", "angular"],
    return: [sink],
} satisfies PGRule;
