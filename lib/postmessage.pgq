import type { PGSelector } from "@js-recon/taintwire";
import { pga } from "./pga.pgq";

// Message listeners and the event.data they read, chained through `uses`: $handler, then $listener.

/** The handler argument of addEventListener("message", h), or the value assigned to onmessage. */
export const handler: PGSelector = {
    cypher: [
        { query: `MATCH ${pga.methodCall("c", "", "ae")},
      (c)${pga.arguments("a0")}(t:StringLiteral), (c)${pga.arguments("a1")}(h)
WHERE ae.name = 'addEventListener' AND a0.idx = 0 AND a1.idx = 1 AND t.value = 'message'
RETURN h.id AS id` },
        { query: `MATCH ${pga.methodCall("c", "", "ae")},
      (c)${pga.arguments("a0")}(t:TemplateLiteral)${pga.quasis}(tq:TemplateElement), (c)${pga.arguments("a1")}(h)
WHERE ae.name = 'addEventListener' AND a0.idx = 0 AND a1.idx = 1 AND tq.value = 'message' AND t.props CONTAINS '"expressions":[]'
RETURN h.id AS id` },
        { query: `MATCH (a:AssignmentExpression)${pga.left}(:MemberExpression)${pga.property}(om:Identifier), (a)${pga.right}(h)
WHERE om.name = 'onmessage'
RETURN h.id AS id` },
    ],
};

/** The listener function itself: the handler when it's a function literal, or the function a handler name refers to. */
export const listener: PGSelector = {
    uses: { handler },
    cypher: [
        { query: `MATCH (f) WHERE f.id IN $handler AND f.type IN ${pga.functions} RETURN f.id AS id` },
        { query: `MATCH (h:Identifier)${pga.refersTo}(d:Identifier)${pga.of.id}(x)
WHERE h.id IN $handler
OPTIONAL MATCH (x)${pga.init}(i)
WITH CASE WHEN x.type IN ${pga.functions} THEN x.id ELSE i.id END AS fid, CASE WHEN x.type IN ${pga.functions} THEN x.type ELSE i.type END AS ft
WHERE ft IN ${pga.functions}
RETURN fid AS id` },
    ],
};

/** event.data reads of a listener's first parameter. */
export const messageData: PGSelector = {
    uses: { listener },
    cypher: { query: `MATCH (f)-[:SON {key: 'params', idx: 0}]->(d:Identifier)${pga.referencedBy}(e:Identifier)${pga.of.object}(n:MemberExpression)${pga.property}(p:Identifier)
WHERE f.id IN $listener AND p.name = 'data'
${pga.ret("'data'")}` },
};
